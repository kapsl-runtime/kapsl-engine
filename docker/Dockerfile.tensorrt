# Kapsl Runtime — TensorRT image
# CUDA 12 + cuDNN + TensorRT 10 with a merged Kapsl CUDA runtime and TensorRT add-on.

FROM python:3.12-slim AS tensorrt-libs

ARG TENSORRT_VERSION=10.16.1.11
RUN python -m pip install --no-cache-dir \
    --no-deps \
    --target /opt/tensorrt \
    --extra-index-url https://pypi.nvidia.com \
    "tensorrt-cu12-libs==${TENSORRT_VERSION}" \
    && test -e /opt/tensorrt/tensorrt_libs/libnvinfer.so.10 \
    && test -e /opt/tensorrt/tensorrt_libs/libnvonnxparser.so.10

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils curl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tensorrt-libs /opt/tensorrt /opt/kapsl/tensorrt-package
RUN echo "/opt/kapsl/tensorrt-package/tensorrt_libs" > /etc/ld.so.conf.d/kapsl-tensorrt.conf \
    && ldconfig \
    && test -e /opt/kapsl/tensorrt-package/tensorrt_libs/libnvinfer.so.10 \
    && test -e /opt/kapsl/tensorrt-package/tensorrt_libs/libnvonnxparser.so.10

ARG KAPSL_VERSION
COPY docker/install-release-assets.sh /tmp/install-release-assets.sh
# ONNX Runtime dlopen()s libonnxruntime_providers_shared.so by bare name, so the
# install directory has to be a loader search path or both providers fall back
# to CPU at runtime. ldd cannot catch that, because the bridge is not a
# DT_NEEDED of either provider; assert the loader can find it by name instead.
# libcuda is mounted by the NVIDIA container runtime, so validate the binary's
# dependency without executing it while BuildKit is constructing the image.
RUN set -eux; \
    test -n "${KAPSL_VERSION}"; \
    KAPSL_VERSION="${KAPSL_VERSION}" \
        sh /tmp/install-release-assets.sh tensorrt; \
    rm /tmp/install-release-assets.sh; \
    readelf -d /usr/local/bin/kapsl | grep -q 'libcuda.so.1'; \
    if ldd /usr/local/bin/kapsl | grep -v 'libcuda\.so\.1' | grep -q 'not found'; then \
        ldd /usr/local/bin/kapsl; \
        exit 1; \
    fi; \
    test -f /usr/local/bin/kapsl-provider-cuda12.json; \
    test -f /usr/local/bin/kapsl-provider-tensorrt10.json; \
    test -f /usr/local/bin/libonnxruntime_providers_cuda.so; \
    test -f /usr/local/bin/libonnxruntime_providers_tensorrt.so; \
    echo "/usr/local/bin" > /etc/ld.so.conf.d/kapsl-runtime.conf; \
    ldconfig; \
    if ldd /usr/local/bin/libonnxruntime_providers_cuda.so \
        /usr/local/bin/libonnxruntime_providers_tensorrt.so | grep -q "not found"; then \
        ldd /usr/local/bin/libonnxruntime_providers_cuda.so \
            /usr/local/bin/libonnxruntime_providers_tensorrt.so; \
        exit 1; \
    fi; \
    ldconfig -p | grep -q "libonnxruntime_providers_shared.so"

RUN mkdir -p /models /data
ENV KAPSL_MODEL_DIR=/models
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 9095

ENTRYPOINT ["kapsl"]
CMD ["--help"]
