# Pinned Microsoft ONNX Runtime GPU release that supplies the Linux x86_64 CUDA and TensorRT
# execution-provider libraries shipped by the engine (sourced by scripts/fetch-microsoft-ort-providers.sh).
# Why: the ort crate's prebuilt provider (pyke, built on Ubuntu 24.04) needs GLIBC_2.38; Microsoft's
# official 1.23.2 libraries need at most GLIBC_2.27 / GLIBCXX_3.4.21. Same ORT version as the engine's
# static core (ort 2.0.0-rc.11 -> ONNX Runtime 1.23.2). The ORT core itself is NOT replaced.
# The values below match kapsl-integrations/integrations/ort/packaging/fetch_ort_gpu_runtime.py.
MS_ORT_VERSION="1.23.2"
MS_ORT_URL="https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-linux-x64-gpu-1.23.2.tgz"
MS_ORT_ARCHIVE_SHA256="2083e361072a79ce16a90dcd5f5cb3ab92574a82a3ce0ac01e5cfa3158176f53"
MS_ORT_ARCHIVE_BYTES="240893669"
MS_ORT_MEMBER_PREFIX="onnxruntime-linux-x64-gpu-1.23.2/lib"
MS_ORT_CUDA_SHA256="78760bb32dcebf7997c6b2300b1d3cbcf3aee8e297998bc4f76c7e1b84c116f1"
MS_ORT_TENSORRT_SHA256="57b27cbd69e488df5e0bfe0368208926ab699cb9d0e83d3734754febeecb4509"
